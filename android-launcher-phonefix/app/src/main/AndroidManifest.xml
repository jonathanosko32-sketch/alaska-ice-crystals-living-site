<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:theme="@style/AppTheme"
        android:label="OSKO Living Layover CODED FIX"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".SkieCbActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LayoverSceneTestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="OSKO Layover v4" />

        <activity
            android:name=".LayoverLivingV5Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="OSKO Living Layover v5" />

        <activity
            android:name=".LayoverLivingV6Activity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="OSKO Living Layover CODED FIX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Test build only: do not register this package as the phone HOME launcher.
             This keeps Samsung/Android from treating the coded test as a replacement
             home screen while we are still testing it side-by-side with protected V11. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
    </application>
</manifest>
